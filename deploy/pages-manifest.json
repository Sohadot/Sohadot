{
  "version": 1,
  "description": "Explicit publication manifest for the GitHub Pages artifact. Every tracked file must match exactly one of 'publish' or 'exclude'; 'publish_exceptions' are individual excluded-area files that public pages link to on sohadot.com and must keep working. Each exception must be referenced by a published page. Unclassified files fail the build. Excluding a file from the Pages artifact does not make it private: this repository is public on GitHub.",
  "publish": [
    "*.html",
    "CNAME",
    ".nojekyll",
    "robots.txt",
    "sitemap.xml",
    "llms.txt",
    "favicon.svg",
    "BingSiteAuth.xml",
    "_headers",
    ".well-known/**",
    "assets/**",
    "js/**",
    "data/**",
    "kb/**",
    "en/**",
    "frameworks/**",
    "geo-domains/**",
    "bundles/**",
    "altissports/**",
    "automation-bundle/**",
    "hygieneroll/**",
    "outbakes/**",
    "reefier/**",
    "san-jose-bundle/**"
  ],
  "publish_exceptions": {
    "docs/CONCEPTUAL_INVENTORY_LEDGER.md": "Linked from conceptual-inventory.html and knowledge-base.html",
    "docs/ESCROW_CLOSING_PROTOCOL.md": "Linked from escrow-closing.html",
    "docs/OPERATOR_ESCROW_LAUNCHER_SPEC.md": "Linked from escrow-closing.html",
    "docs/TOP_75_MEANING_LOCK_QUEUE.md": "Linked from top-75-queue.html",
    "scripts/generate_conceptual_inventory.py": "Linked from conceptual-inventory.html",
    "scripts/generate_top_75_queue.py": "Linked from top-75-queue.html",
    "scripts/validate_asset_meanings.py": "Linked from category-artifacts.html and conceptual-inventory.html",
    "scripts/validate_category_clusters.py": "Linked from category-clusters.html",
    "scripts/validate_conceptual_inventory.py": "Linked from conceptual-inventory.html",
    "scripts/validate_protected_meanings.py": "Linked from conceptual-inventory.html",
    "scripts/validate_top_75_queue.py": "Linked from top-75-queue.html"
  },
  "exclude": [
    ".github/**",
    ".gitignore",
    "deploy/**",
    "docs/**",
    "research/**",
    "scripts/**",
    "tests/**",
    "README.md",
    "DECISION_LOG.md",
    "LICENSE"
  ],
  "required": [
    "index.html",
    "404.html",
    "CNAME",
    ".nojekyll",
    "robots.txt",
    "sitemap.xml",
    "favicon.svg",
    "valuation.html",
    "js/valuation-engine.js",
    "js/valuation-ui.js",
    "data/valuation_comps.json"
  ]
}
