{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sohadot/Sohadot/research/valuation-evidence/schema/transaction-evidence.v1.schema.json",
  "title": "Sohadot Transaction Evidence Registry v1",
  "description": "Structural schema. Cross-field evidence, provenance, rights, role, holdout and dataset rules are enforced by scripts/validate_evidence_registry.py and documented in docs/valuation-evidence/TRANSACTION_EVIDENCE_REGISTRY_V1.md.",
  "type": "object",
  "required": [
    "schema_version",
    "registry_version",
    "as_of",
    "dataset_status",
    "transaction_count",
    "status_counts",
    "role_counts",
    "content_sha256",
    "transactions"
  ],
  "properties": {
    "schema_version": {
      "const": "transaction-evidence/v1"
    },
    "registry_version": {
      "type": "string"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "dataset_status": {
      "const": "RESEARCH_ONLY_NOT_FOR_PRODUCTION"
    },
    "description": {
      "type": "string"
    },
    "transaction_count": {
      "type": "integer"
    },
    "status_counts": {
      "type": "object"
    },
    "role_counts": {
      "type": "object"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transaction_id",
          "domain",
          "sale_price",
          "currency",
          "price_scope",
          "bundle",
          "sale_date",
          "sale_date_precision",
          "report_date",
          "venue",
          "transaction_type",
          "consideration_type",
          "market_side",
          "source_name",
          "source_url",
          "source_type",
          "source_access_method",
          "source_accessed_at",
          "review_method",
          "document_locator",
          "checked_quote",
          "document_sha256",
          "additional_sources",
          "leads",
          "price_disclosure_status",
          "price_claims",
          "conflicts",
          "valuation_caveats",
          "evidence_status",
          "verification_basis",
          "verified_at",
          "attesting_party",
          "settlement_evidence",
          "rights",
          "calibration_role",
          "notes"
        ],
        "properties": {
          "transaction_id": {
            "type": "string",
            "pattern": "^SOH-TX-\\d{6}$",
            "description": "Stable identifier; never reused or renumbered."
          },
          "domain": {
            "type": "string"
          },
          "sale_price": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "In `currency`; scope given by price_scope. Null when undisclosed or unknown."
          },
          "currency": {
            "enum": [
              "AUD",
              "CAD",
              "CHF",
              "CNY",
              "EUR",
              "GBP",
              "JPY",
              "USD"
            ]
          },
          "price_scope": {
            "enum": [
              "BUNDLE_TOTAL",
              "BUSINESS_TOTAL",
              "SINGLE_DOMAIN",
              "UNKNOWN"
            ]
          },
          "bundle": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "domain_count": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "other_assets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "allocation": {
                "const": "NOT_ALLOCATED"
              }
            },
            "description": "Required when price_scope is BUNDLE_TOTAL."
          },
          "sale_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "sale_date_precision": {
            "enum": [
              "DAY",
              "MONTH",
              "UNKNOWN",
              "YEAR"
            ]
          },
          "report_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "Publication date of the principal reviewed source (partial ISO date)."
          },
          "venue": {
            "enum": [
              "AUCTION",
              "BANKRUPTCY_SALE",
              "BROKER",
              "CORPORATE_TRANSACTION",
              "MARKETPLACE",
              "PRIVATE",
              "UNKNOWN"
            ]
          },
          "transaction_type": {
            "enum": [
              "BUSINESS_ASSETS",
              "DOMAIN_ONLY",
              "DOMAIN_PLUS_ASSETS",
              "MULTIPLE_DOMAINS",
              "UNKNOWN",
              "WEBSITE_BUSINESS"
            ]
          },
          "consideration_type": {
            "enum": [
              "CASH",
              "CASH_AND_NOTE",
              "CASH_AND_OTHER",
              "CASH_AND_STOCK",
              "CRYPTOCURRENCY",
              "STOCK",
              "STRUCTURED",
              "UNKNOWN"
            ]
          },
          "market_side": {
            "enum": [
              "END_USER_ACQUISITION",
              "INVESTOR_TRADE",
              "UNKNOWN"
            ]
          },
          "source_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_type": {
            "enum": [
              "AGGREGATOR_DATABASE",
              "COURT_RECORD",
              "GENERAL_NEWS",
              "MARKETPLACE_RECORD",
              "NONE",
              "PARTY_ANNOUNCEMENT",
              "REGULATORY_FILING",
              "TERTIARY_REFERENCE",
              "TRADE_PUBLICATION"
            ]
          },
          "source_access_method": {
            "enum": [
              "DOCUMENT_REVIEWED",
              "NOT_ACCESSED"
            ]
          },
          "source_accessed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_method": {
            "enum": [
              "NONE",
              "RAW_TEXT_CHECKED",
              "TOOL_EXTRACT_CHECKED_AGAINST_RAW",
              "TOOL_EXTRACT_UNCHECKED"
            ]
          },
          "document_locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "checked_quote": {
            "type": [
              "string",
              "null"
            ]
          },
          "document_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "additional_sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_name",
                "source_url",
                "source_type",
                "published_date",
                "source_access_method",
                "source_accessed_at",
                "review_method",
                "document_locator",
                "checked_quote",
                "document_sha256"
              ],
              "properties": {
                "source_name": {
                  "type": "string"
                },
                "source_url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "source_type": {
                  "enum": [
                    "AGGREGATOR_DATABASE",
                    "COURT_RECORD",
                    "GENERAL_NEWS",
                    "MARKETPLACE_RECORD",
                    "NONE",
                    "PARTY_ANNOUNCEMENT",
                    "REGULATORY_FILING",
                    "TERTIARY_REFERENCE",
                    "TRADE_PUBLICATION"
                  ]
                },
                "published_date": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source_access_method": {
                  "const": "DOCUMENT_REVIEWED"
                },
                "source_accessed_at": {
                  "type": "string",
                  "format": "date"
                },
                "review_method": {
                  "enum": [
                    "RAW_TEXT_CHECKED",
                    "TOOL_EXTRACT_CHECKED_AGAINST_RAW"
                  ]
                },
                "document_locator": {
                  "type": "string",
                  "minLength": 8
                },
                "checked_quote": {
                  "type": "string",
                  "minLength": 20,
                  "description": "Verbatim text checked against the reviewed document."
                },
                "document_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "SHA-256 of the bytes retrieved at review time."
                }
              }
            }
          },
          "leads": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_name",
                "source_url",
                "source_type",
                "observed_at",
                "note"
              ],
              "properties": {
                "source_name": {
                  "type": "string"
                },
                "source_url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "source_type": {
                  "enum": [
                    "AGGREGATOR_DATABASE",
                    "COURT_RECORD",
                    "GENERAL_NEWS",
                    "MARKETPLACE_RECORD",
                    "NONE",
                    "PARTY_ANNOUNCEMENT",
                    "REGULATORY_FILING",
                    "TERTIARY_REFERENCE",
                    "TRADE_PUBLICATION"
                  ]
                },
                "observed_at": {
                  "type": "string",
                  "format": "date"
                },
                "note": {
                  "type": "string"
                }
              },
              "description": "Search-index summary or unreviewed pointer. Never evidence."
            }
          },
          "price_disclosure_status": {
            "enum": [
              "APPROXIMATE",
              "EXACT",
              "LOWER_BOUND",
              "ROUNDED",
              "STATED_SUBJECT_TO_ADJUSTMENT",
              "UNDISCLOSED",
              "UNKNOWN"
            ]
          },
          "price_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "amount",
                "currency",
                "source",
                "qualifier"
              ]
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "description",
                "material"
              ]
            },
            "description": "Contradictions about the transaction itself."
          },
          "valuation_caveats": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Limits on what the price says about value. Never change evidence status."
          },
          "evidence_status": {
            "enum": [
              "DISPUTED",
              "REPORTED",
              "UNVERIFIED",
              "VERIFIED"
            ]
          },
          "verification_basis": {
            "type": [
              "string",
              "null"
            ]
          },
          "verified_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "attesting_party": {
            "enum": [
              "BROKER",
              "BUYER",
              "COURT",
              "NONE",
              "SELLER",
              "VENUE"
            ],
            "description": "Who vouches for the transaction in the principal source. NONE unless VERIFIED."
          },
          "settlement_evidence": {
            "enum": [
              "NOT_ESTABLISHED",
              "PARTY_ATTESTATION_ONLY",
              "REGULATED_FILING_OR_COURT_RECORD"
            ],
            "description": "REGULATED_FILING_OR_COURT_RECORD for filings and court records; PARTY_ATTESTATION_ONLY for a party's own announcement (not independently confirmed settlement); NOT_ESTABLISHED unless VERIFIED."
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "citation",
              "storage",
              "commercial_modelling",
              "redistribution"
            ],
            "properties": {
              "citation": {
                "type": "object",
                "required": [
                  "status",
                  "basis_type",
                  "basis",
                  "reference"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "NOT_ESTABLISHED",
                      "NOT_PERMITTED",
                      "PERMITTED",
                      "PERMITTED_WITH_CONDITIONS"
                    ]
                  },
                  "basis_type": {
                    "enum": [
                      "DOCUMENTED_LAWFUL_BASIS",
                      "LICENSE",
                      "NONE",
                      "PUBLIC_FACT_CITATION",
                      "PUBLIC_RECORD",
                      "WRITTEN_PERMISSION"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 20
                  },
                  "reference": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "storage": {
                "type": "object",
                "required": [
                  "status",
                  "basis_type",
                  "basis",
                  "reference"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "NOT_ESTABLISHED",
                      "NOT_PERMITTED",
                      "PERMITTED",
                      "PERMITTED_WITH_CONDITIONS"
                    ]
                  },
                  "basis_type": {
                    "enum": [
                      "DOCUMENTED_LAWFUL_BASIS",
                      "LICENSE",
                      "NONE",
                      "PUBLIC_FACT_CITATION",
                      "PUBLIC_RECORD",
                      "WRITTEN_PERMISSION"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 20
                  },
                  "reference": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "commercial_modelling": {
                "type": "object",
                "required": [
                  "status",
                  "basis_type",
                  "basis",
                  "reference"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "NOT_ESTABLISHED",
                      "NOT_PERMITTED",
                      "PERMITTED",
                      "PERMITTED_WITH_CONDITIONS"
                    ]
                  },
                  "basis_type": {
                    "enum": [
                      "DOCUMENTED_LAWFUL_BASIS",
                      "LICENSE",
                      "NONE",
                      "PUBLIC_FACT_CITATION",
                      "PUBLIC_RECORD",
                      "WRITTEN_PERMISSION"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 20
                  },
                  "reference": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "redistribution": {
                "type": "object",
                "required": [
                  "status",
                  "basis_type",
                  "basis",
                  "reference"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "NOT_ESTABLISHED",
                      "NOT_PERMITTED",
                      "PERMITTED",
                      "PERMITTED_WITH_CONDITIONS"
                    ]
                  },
                  "basis_type": {
                    "enum": [
                      "DOCUMENTED_LAWFUL_BASIS",
                      "LICENSE",
                      "NONE",
                      "PUBLIC_FACT_CITATION",
                      "PUBLIC_RECORD",
                      "WRITTEN_PERMISSION"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 20
                  },
                  "reference": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "calibration_role": {
            "enum": [
              "CALIBRATION_CANDIDATE",
              "EXCLUDED",
              "HOLDOUT_CANDIDATE",
              "REFERENCE_ONLY",
              "UNDETERMINED"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
